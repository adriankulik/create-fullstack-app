{
  "name": "@adriankulik/create-fullstack-app",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.1",
  "description": "A CLI tool for scaffolding a full-stack web application with your choice of frontend and backend technologies.",
  "main": "cli/index.js",
  "bin": {
    "create-fullstack-app": "./cli/index.js"
  },
  "files": [
    "cli",
    "templates"
  ],
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "fs-extra": "^11.3.4",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.10"
  },
  "scripts": {
    "test": "echo \"No unit tests specified\" && exit 0",
    "test:e2e": "vitest run tests/e2e.test.js",
    "test:integration": "npx playwright test tests/integration.spec.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adriankulik/create-fullstack-app.git"
  },
  "keywords": [
    "cli",
    "scaffold",
    "fullstack",
    "react",
    "nextjs",
    "angular",
    "vue",
    "svelte",
    "fastapi",
    "flask",
    "dotnet",
    "express",
    "boilerplate",
    "starter"
  ],
  "author": "Adrian Kulik",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adriankulik/create-fullstack-app/issues"
  },
  "homepage": "https://github.com/adriankulik/create-fullstack-app#readme"
}
