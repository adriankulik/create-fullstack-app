# ==========================================
# Application Configuration Template
# Copy this file to .env.local for local overrides.
# NOTE: Secrets placed in .env.local or .env.secrets are NEVER mounted into the AI sandbox.
# ==========================================

# Database
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=appdb
POSTGRES_PORT=5432

# Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# AI Sandbox & Egress Security (Pipelock)
PIPELOCK_MODE=balanced
PIPELOCK_PORT=8888
