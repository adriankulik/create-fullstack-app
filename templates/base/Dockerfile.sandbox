FROM node:22-bookworm-slim

# Install system utilities, python, and git
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    git \
    curl \
    ca-certificates \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Create non-root developer user
RUN groupadd -g 1001 developer || true && \
    useradd -u 1001 -g 1001 -m -s /bin/bash developer || true

WORKDIR /workspace

# Set default user
USER developer

CMD ["/bin/bash"]
